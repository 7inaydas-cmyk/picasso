{
  "gates": [
    { "id": "task-coverage-staged", "invocation": "node tools/task-coverage.mjs --staged", "transports": ["pre-commit"], "phase": "executing", "checks": "staged code inside an in-flight task's declared scope" },
    { "id": "task-coverage-commit-msg", "invocation": "node tools/task-coverage.mjs --commit-msg", "transports": ["commit-msg"], "phase": "executing", "checks": "exactly one trailer-block task footer covering the staged files" },
    { "id": "task-coverage-push", "invocation": "node tools/task-coverage.mjs --push", "transports": ["pre-push"], "phase": "verified", "checks": "every commit in range footered and in-scope" },
    { "id": "task-coverage-doctor", "invocation": "node tools/task-coverage.mjs --doctor", "transports": ["pre-push"], "phase": "verified", "checks": "clone wiring intact" },
    { "id": "gate-registry-check", "invocation": "node tools/gate-registry.mjs", "transports": ["pre-push", "battery"], "phase": "verified", "checks": "declared gates present in every transport, no shadows" },
    { "id": "design-token-lint", "invocation": "npx eslint . --max-warnings 0", "transports": ["ci"], "phase": "verified", "checks": "@shadcn/lint token register + no-restyle contracts under the ratchet cap" },
    { "id": "lint-budget-gate-script", "invocation": "node tools/lint-budget.mjs --check --linter eslint", "transports": ["battery"], "phase": "verified", "checks": "the npm lint script runs the capped eslint invocation" },
    { "id": "render-gate", "invocation": "npm run render:gate", "transports": ["ci"], "phase": "verified", "checks": "headless render of every route; console ratchet + a11y ratchet + render-failure ratchet all judge clean" },
    { "id": "render-gate-console-ratchet", "invocation": "node tools/console-ratchet.mjs --report reports/console-report.json --baseline baselines/console-baseline.json", "transports": ["battery"], "phase": "verified", "checks": "the render:gate script judges the console report against its baseline" },
    { "id": "render-gate-a11y-ratchet", "invocation": "node tools/a11y-ratchet.mjs --violations reports/a11y-report.json --baseline baselines/a11y-baseline.json --render-failures reports/render-failures.json --render-baseline baselines/render-baseline.json", "transports": ["battery"], "phase": "verified", "checks": "the render:gate script judges axe violations and render failures against their baselines" },
    { "id": "budget-gate", "invocation": "npm run budget:gate", "transports": ["ci"], "phase": "verified", "checks": "built artifacts within declared budgets" },
    { "id": "budget-gate-script", "invocation": "node tools/size-budget.mjs --budgets budgets.json", "transports": ["battery"], "phase": "verified", "checks": "the npm budget:gate script runs the size-budget invocation" },
    { "id": "build", "invocation": "npm run build", "transports": ["ci"], "phase": "verified", "checks": "typecheck (tsc -b) + production build" },
    { "id": "battery-self-tests", "invocation": "npm run selftest", "transports": ["ci"], "phase": "executing", "checks": "vendored picasso tools all self-test clean" },
    { "id": "task-state-self-test", "invocation": "node tools/task-state.mjs --self-test", "transports": ["battery"], "phase": "executing", "checks": "lifecycle refusals discriminate" },
    { "id": "task-coverage-self-test", "invocation": "node tools/task-coverage.mjs --self-test", "transports": ["battery"], "phase": "executing", "checks": "scope matcher and footer law discriminate" },
    { "id": "lint-budget-self-test", "invocation": "node tools/lint-budget.mjs --self-test", "transports": ["battery"], "phase": "executing", "checks": "lint ratchet cap only decreases" },
    { "id": "ratchet-self-test", "invocation": "node tools/ratchet.mjs --self-test", "transports": ["battery"], "phase": "executing", "checks": "shared baseline law discriminates" },
    { "id": "a11y-ratchet-self-test", "invocation": "node tools/a11y-ratchet.mjs --self-test", "transports": ["battery"], "phase": "executing", "checks": "a11y ratchet discriminates" },
    { "id": "console-ratchet-self-test", "invocation": "node tools/console-ratchet.mjs --self-test", "transports": ["battery"], "phase": "executing", "checks": "console ratchet discriminates" },
    { "id": "size-budget-self-test", "invocation": "node tools/size-budget.mjs --self-test", "transports": ["battery"], "phase": "executing", "checks": "size budgets: over fails, missing fails, wildcards sum" },
    { "id": "gate-registry-self-test", "invocation": "node tools/gate-registry.mjs --self-test", "transports": ["battery"], "phase": "executing", "checks": "drift checker discriminates both directions" },
    { "id": "task-state-metrics", "invocation": "node tools/task-state.mjs metrics", "transports": ["battery"], "phase": "executing", "checks": "lifecycle register readable from the battery" }
