{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|ApplyPatch",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/authoring-gate.mjs"],
            "timeoutMs": 15000,
            "statusMessage": "picasso: judging the edit against the front-end jurisdiction"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/banner.mjs"],
            "timeoutMs": 10000,
            "statusMessage": "picasso: loading the live front-end task state"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/banner.mjs"],
            "timeoutMs": 10000,
            "statusMessage": "picasso: refreshing the front-end banner"
          }
        ]
      }
    ]
  }
}
